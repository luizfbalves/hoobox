# Desenvolvimento local (API no host, MySQL/Redis em localhost ou só infra via compose)
DATABASE_URL="mysql://root:root@localhost:3306/hoobox"
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3333

# Auth (obrigatória)
JWT_SECRET=6f0ba32f-2d26-4d75-a890-bda89edf5e6c
JWT_EXPIRES_IN_SECONDS=3600

# Logs (opcional)
LOG_LEVEL=info

# Outbox (opcional)
OUTBOX_POLL_MS=500
OUTBOX_PUBLISH_TIMEOUT_MS=5000

# Worker / fila (opcional)
ORDER_WORKER_CONCURRENCY=1
ORDER_PROCESSING_DELAY_MS=1500
ORDER_QUEUE_BACKOFF_MS=1000
