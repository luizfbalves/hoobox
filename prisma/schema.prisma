generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum OrderStatus {
  PENDING
  PROCESSED
  FAILED
}

enum UserRole {
  ADMIN
  USER
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]

  @@map("customers")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  totalCents    Int         @map("total_cents")
  status        OrderStatus @default(PENDING)
  failureReason String?     @map("failure_reason") @db.VarChar(255)
  correlationId String?     @map("correlation_id") @db.VarChar(36)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt, id])
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("order_items")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  priceCents Int         @map("price_cents")
  stock      Int         @default(5)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("products")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  aggregateId Int       @map("aggregate_id")
  eventType   String    @map("event_type") @db.VarChar(64)
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, id])
  @@map("outbox_events")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
